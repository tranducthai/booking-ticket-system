# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.turbo/
coverage/

# Prisma generates its client per-service into src/generated/ (custom
# `output` path — avoids every service colliding on the same
# node_modules/@prisma/client under pnpm's dedup, see Phase 4/8 commits)
apps/*/src/generated/

