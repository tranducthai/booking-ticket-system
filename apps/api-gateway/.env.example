PORT=3000
JWT_ACCESS_SECRET=change-me-access
USER_SERVICE_URL=http://localhost:3001
EVENT_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
TICKET_SERVICE_URL=http://localhost:3005
NOTIFICATION_SERVICE_URL=http://localhost:3006
CORS_ORIGIN=*
RATE_LIMIT_GENERAL_PER_MIN=300
# Login brute-force guard: after this many WRONG passwords from one IP, login is refused for LOGIN_LOCKOUT_MINUTES. Successful logins never count.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Shared secret (same value on every service). The gateway sends it as
# X-Gateway-Token so services can trust X-User-Id/X-User-Role only from the
# gateway. Required when NODE_ENV=production; empty = local-dev mode.
INTERNAL_TOKEN=
