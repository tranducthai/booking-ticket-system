PORT=3003
DATABASE_URL=postgresql://user:password@localhost:5435/booking_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENT_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3004
# Mirrors event-service's SEAT_HOLD_TTL_SECONDS — Order.expiresAt should track the same window.
HOLD_TTL_SECONDS=600
# Shared secret checked on /internal/* routes (docs/spec/12-resilience-and-failure-design.md).
# Leave unset in local dev to skip the check; every service must agree on the same value when set.
INTERNAL_TOKEN=
