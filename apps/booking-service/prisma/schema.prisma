// Booking Service — owns ORDERS, ORDER_ITEMS. See docs/spec/07-database-schema.md §3.

generator client {
  provider = "prisma-client-js"
  // See apps/user-service/prisma/schema.prisma for why this is here.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  TICKET_ISSUED
  CANCELED
  EXPIRED
}

// TICKETS: the normal ticket order. MEMBERSHIP: an artist's membership card
// (event-service ArtistMembershipPlan) — no items, no eventId; paying it
// activates the card instead of issuing tickets (order-fulfillment.service.ts).
enum OrderKind {
  TICKETS
  MEMBERSHIP
  // Buying a ticket another customer listed for resale (ResaleListing). One
  // item; once paid the seller's ticket is voided and the buyer's is issued
  // through the normal OrderPaid flow.
  RESALE
}

model Order {
  id                   String      @id @default(uuid())
  userId               String // ID-only reference into user-service
  kind                 OrderKind   @default(TICKETS)
  eventId              String? // ID-only reference into event-service (denormalized for query convenience) — null for MEMBERSHIP
  membershipPlanId     String? // ID-only reference into event-service — set for MEMBERSHIP
  resaleListingId      String? // set for RESALE — the ResaleListing being bought
  // What the order is for when it isn't an event — the plan + artist name at purchase time.
  itemLabel            String?
  status               OrderStatus @default(PENDING_PAYMENT)
  subtotal             Decimal     @db.Decimal(12, 2)
  discountCode         String?
  discountAmount       Decimal     @default(0) @db.Decimal(12, 2)
  // Membership-card discount (event-service purchase-check), taken off the
  // subtotal at hold time; a discount code then applies to what's left.
  memberDiscountAmount Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal     @db.Decimal(12, 2)
  expiresAt            DateTime? // hold expiry for the whole order (mirrors the Redis TTL in event-service)
  // Set when Payment Service starts a payment attempt (see
  // sagas/../orders.service.ts startPayment()) — HoldsSweeperService skips
  // orders mid-payment even if expiresAt has technically passed, and the
  // hold is extended in event-service at the same moment. Reset back to
  // false once the order leaves PENDING_PAYMENT either way.
  paymentInProgress    Boolean     @default(false)
  // Guards releaseTicketType/releaseSeat against being fired twice for the
  // same order (PaymentFailed + the sweeper can race) — see
  // docs/spec/12-resilience-and-failure-design.md "make releaseTicketType
  // idempotent, track reservationReleased on the order".
  holdReleased         Boolean     @default(false)
  // Sum of every RefundApproved paid back on this order so far — per-ticket
  // refunds leave the order active, so revenue is totalAmount - this.
  refundedAmount       Decimal     @default(0) @db.Decimal(12, 2)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([eventId])
}

model OrderItem {
  id            String    @id @default(uuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id])
  ticketTypeId  String? // ID-only reference into event-service — set for General Admission
  seatId        String? // ID-only reference into event-service — set for Seat Map
  price         Decimal   @db.Decimal(12, 2) // snapshot at purchase time, never re-read from event-service
  quantity      Int       @default(1) // 1 per admission since per-ticket refunds (cart.service.ts); older GA rows may carry more
  // Set when a refund paid this ticket back (RefundApproved.orderItemIds). The
  // order becomes CANCELED only once every item is refunded.
  refundedAt    DateTime?
  // Set when the ticket of this item was resold (ResaleListing SOLD): the seller
  // no longer holds it, so event-cancellation refunds skip it.
  transferredAt DateTime?

  @@index([orderId])
}

/**
 * Pulled forward from Phase 8c (docs/spec/12-resilience-and-failure-design.md) —
 * RabbitMQ only guarantees at-least-once delivery, so every consumer here
 * (PaymentSucceeded/PaymentFailed/RefundApproved) records the envelope's
 * eventId before acting, inside the same transaction as the state change.
 * A redelivered event is a no-op instead of double-processing.
 */
model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  consumer    String // e.g. "payment-succeeded", "refund-approved"
  processedAt DateTime @default(now())
}

/**
 * Append-only activity/audit log — docs/spec/14-activity-log-design.md.
 * Every service keeps its own (database-per-service); the frontend merges
 * the five feeds. A DB trigger (see this table's migration) rejects UPDATE
 * and DELETE, so a row, once written, is evidence.
 */
model ActivityLog {
  id            String   @id @default(uuid())
  actorId       String // userId, "system" for consumers/crons, "anonymous" for e.g. a failed login
  actorRole     String? // CUSTOMER | ORGANIZER | ADMIN | SYSTEM
  action        String // "<entity>.<verb>", e.g. "order.created"
  targetType    String
  targetId      String?
  eventId       String? // ID-only reference into event-service — scope of the organizer's per-event log
  subjectUserId String? // ID-only reference into user-service — whose account this concerns (customer's "my activity")
  summary       String
  metadata      Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([eventId, createdAt])
  @@index([createdAt])
}

enum ResaleStatus {
  ACTIVE // on the marketplace
  RESERVED // a buyer's RESALE order is pending payment
  SOLD
  CANCELED // withdrawn by the seller
}

/**
 * "Bán lại vé": a customer resells one of their issued tickets. Price is
 * capped at what they paid (no scalping); the platform keeps feeAmount and
 * the seller is owed price - feeAmount once SOLD. The ticket is locked in
 * ticket-service (RESALE_LISTED) for as long as the listing is open.
 */
model ResaleListing {
  id              String       @id @default(uuid())
  code            String       @unique // "RSL-482913" — shown on the marketplace card
  sellerId        String // ID-only reference into user-service
  eventId         String // ID-only reference into event-service
  ticketId        String // ID-only reference into ticket-service
  orderItemId     String // the seller's OrderItem the ticket was issued for
  ticketTypeId    String? // copied from that item — what the buyer's new ticket is for
  seatId          String?
  facePrice       Decimal      @db.Decimal(12, 2) // what the seller paid — the price cap
  price           Decimal      @db.Decimal(12, 2)
  feeAmount       Decimal      @db.Decimal(12, 2)
  status          ResaleStatus @default(ACTIVE)
  reservedOrderId String? // the buyer's pending RESALE order
  buyerId         String?
  soldAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([eventId, status])
  @@index([sellerId])
  @@index([ticketId])
}
