PORT=3002
DATABASE_URL=postgresql://user:password@localhost:5434/event_db
REDIS_URL=redis://localhost:6379
SEAT_HOLD_TTL_SECONDS=600
RABBITMQ_URL=amqp://guest:guest@localhost:5672
MAX_SEATS_PER_USER_PER_EVENT=8
WAITING_ROOM_RELEASE_BATCH=50
WAITING_ROOM_MAX_QUEUE_MULTIPLIER=5
# Shared secret checked on /internal/* routes (docs/spec/12-resilience-and-failure-design.md).
# Leave unset in local dev to skip the check; every service must agree on the same value when set.
INTERNAL_TOKEN=
