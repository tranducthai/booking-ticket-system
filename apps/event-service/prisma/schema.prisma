// Event Service — owns EVENTS, CATEGORIES, TICKET_TYPES, SEAT_MAPS,
// SEAT_ZONES, SEATS, DISCOUNT_CODES. See docs/spec/07-database-schema.md §2.

generator client {
  provider = "prisma-client-js"
  // See apps/user-service/prisma/schema.prisma for why this is here.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketMode {
  GENERAL // General Admission
  SEATMAP // Seat Selection
  FREE_ENTRY // Free, open entry — no tickets, no registration; the page just says "vào cửa tự do"
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  CANCELED
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
  BLOCKED
}

enum DiscountType {
  PERCENT
  FIXED
}

/**
 * Both are checked in the same way (ticket-service's QR check-in) — this
 * only changes what the buyer sees ("e-ticket" vs "in ở nhà rồi mang theo").
 * See docs/spec conversation: real ticketing systems print the same signed
 * QR on paper for PRINT_AT_HOME rather than running a second, weaker
 * validation path for "physical" tickets.
 */
enum TicketDeliveryMethod {
  E_TICKET
  PRINT_AT_HOME
}

model Category {
  id     String  @id @default(uuid())
  name   String  @unique
  slug   String  @unique
  events Event[]
}

model Event {
  id                   String      @id @default(uuid())
  organizerId          String // ID-only reference into user-service
  categoryId           String
  category             Category    @relation(fields: [categoryId], references: [id])
  title                String
  description          String?
  bannerUrl            String?
  // Portrait (4:5) "ảnh sự kiện" for the event cards; bannerUrl is the wide cover on the event page. Cards fall back to bannerUrl.
  posterUrl            String?
  galleryUrls          String[]    @default([])
  // Shown on the event page's "Ban tổ chức" section — per event rather than
  // read from the organizer's user-service profile, so one organizer account
  // can run events under different brands (and no cross-service call on the hot read path).
  organizerName        String?
  organizerLogoUrl     String?
  organizerDescription String?
  terms                String? // event-specific terms & conditions, shown on the event page
  minAge               Int? // minimum attendee age, displayed only (not verified at check-in); null = all ages
  // Image of the venue's ticket zones ("sơ đồ hạng mục vé") shown above the ticket tiers on the event
  // page — a picture, not the interactive SeatMap (that one is for SEATMAP events' individual seats).
  zoneMapUrl           String?
  // Caps how many tickets (across ticket types) one account may hold for
  // this event — enforced by booking-service at hold time, not here (that's
  // the only place userId + eventId + requested quantity are all present
  // before inventory is reserved). Null = no cap.
  maxTicketsPerAccount Int?
  venueName            String // offline: venue name; online: platform shown to everyone (e.g. "Zoom")
  venueAddress         String // full display address — for offline events composed from streetAddress, ward, province
  // Structured address (event-creation wizard). Province/ward are the post-2025
  // two-level administrative units (34 provinces); null on events created before.
  isOnline             Boolean     @default(false)
  province             String?
  ward                 String?
  streetAddress        String?
  startTime            DateTime
  endTime              DateTime
  ticketMode           TicketMode
  status               EventStatus @default(DRAFT)
  rejectedReason       String?
  salesStartTime       DateTime?
  salesEndTime         DateTime?
  refundPolicy         Json? // RefundPolicy from libs/event-contracts — editable only while DRAFT/REJECTED, so buyers are always held to the policy shown when they paid
  // docs/spec/13-refund-and-anti-fraud-design.md §2.3 — organizer asks,
  // admin decides. Sales stop while a request is pending (booking-service
  // refuses holds when cancelRequestedAt is set).
  cancelRequestedAt    DateTime?
  cancelRequestReason  String?
  canceledAt           DateTime?
  cancelReason         String?
  // §2.4 — set on postpone; ticket holders get a 100% refund on request until refundWindowEndsAt.
  postponedAt          DateTime?
  refundWindowEndsAt   DateTime?
  // docs/spec/11-implementation-roadmap.md Phase 8b — gates the waiting
  // room (waiting-room/) on this event's detail + seat-map state routes.
  // Off by default: normal events skip the queue entirely.
  highDemand           Boolean     @default(false)
  // Organizer opt-in: holders of an active membership card (ArtistMembership)
  // of an artist in this lineup may buy early (presale) and get the card's
  // discount. Off by default — the discount comes out of the organizer's revenue.
  memberBenefits       Boolean     @default(false)
  // "Mở bán lại vé còn trống": after the regular sales window closed, the
  // organizer can reopen whatever is unsold (tiers and seats) until this
  // time (at most the event start). purchase-window.ts honors it.
  lateSalesUntil       DateTime?
  // Set once the T-24h reminder email has gone out (notification-service
  // event-reminder.service.ts) — prevents re-sending on the next poll tick.
  reminderSentAt       DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  ticketTypes   TicketType[]
  showtimes     Showtime[]
  seatMap       SeatMap?
  discountCodes DiscountCode[]
  favorites     EventFavorite[]
  lineup        EventArtist[]
  privateInfo   EventPrivateInfo?

  @@index([startTime])
  @@index([organizerId])
  @@index([status])
}

/**
 * Customer's saved/wishlisted events — ID-only reference to user-service for userId, same convention as Order.userId etc elsewhere in this codebase.
 */
model EventFavorite {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, eventId])
  @@index([userId])
}

/**
 * Ticketmaster/Eventbrite both model artists as their own entity, reused
 * across events, rather than a free-text field on Event — same choice here.
 * Scoped to the categories that make sense for a lineup (Nhạc sống, Sân
 * khấu & Nghệ thuật); enforced client-side only (lib/categories.ts), not
 * worth a DB constraint for a UI-level judgment call.
 */
/**
 * An artist an organizer adds is a request to the admins: PENDING until one
 * approves it (APPROVED, which also verifies it) or rejects it with a reason.
 * Admin-created and pre-existing artists are APPROVED.
 */
enum ArtistStatus {
  PENDING
  APPROVED
  REJECTED
}

model Artist {
  id             String       @id @default(uuid())
  name           String
  avatarUrl      String?
  coverUrl       String? // wide banner on the artist page
  // Who added the artist (ID-only reference into user-service) — null for artists from before this was tracked.
  // An organizer may edit their own artists until an admin verifies them (ArtistsService.update).
  createdById    String?
  bio            String?
  socialLinks    Json?
  isVerified     Boolean      @default(false)
  status         ArtistStatus @default(APPROVED)
  rejectedReason String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events         EventArtist[]
  membershipPlan ArtistMembershipPlan?
  memberships    ArtistMembership[]
  follows        ArtistFollow[]
  posts          ArtistPost[]

  @@index([name])
  @@index([createdById])
  @@index([status])
}

/**
 * The artist's fan-club card ("Thẻ thành viên") — one plan per artist, set
 * up by an admin (the artist directory is shared, like Category). Bought
 * through booking-service as an Order of kind MEMBERSHIP, so it rides the
 * normal payment saga; price 0 = free registration.
 */
model ArtistMembershipPlan {
  id              String   @id @default(uuid())
  artistId        String   @unique
  artist          Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  name            String
  price           Decimal  @db.Decimal(12, 2)
  durationDays    Int
  // Benefits on events that opted in (Event.memberBenefits) and have this artist in the lineup:
  discountPercent Int      @default(0) // off the ticket subtotal
  presaleHours    Int      @default(0) // may buy this many hours before general sale opens
  benefits        String? // any other perks, free text shown on the card
  isActive        Boolean  @default(true) // false = no new sign-ups; existing cards keep working
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships ArtistMembership[]
}

enum MembershipStatus {
  ACTIVE
  CANCELED
}

/**
 * One card per purchase. "Đã hết hạn" isn't a stored status — it's ACTIVE
 * with expiresAt in the past. Benefits are snapshotted from the plan at
 * purchase, so editing the plan never changes a card someone already bought.
 */
model ArtistMembership {
  id              String               @id @default(uuid())
  planId          String
  plan            ArtistMembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  artistId        String
  artist          Artist               @relation(fields: [artistId], references: [id], onDelete: Restrict)
  userId          String // ID-only reference into user-service
  // booking-service order that paid for it — unique so a redelivered
  // activation (payment saga is at-least-once) is a no-op.
  orderId         String               @unique
  cardNumber      String               @unique
  status          MembershipStatus     @default(ACTIVE)
  pricePaid       Decimal              @db.Decimal(12, 2)
  discountPercent Int
  presaleHours    Int
  startsAt        DateTime             @default(now())
  expiresAt       DateTime
  canceledAt      DateTime?
  createdAt       DateTime             @default(now())

  @@index([userId])
  @@index([artistId, userId])
}

/**
 * Join row for an event's lineup, ordered.
 */
model EventArtist {
  id       String @id @default(uuid())
  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  order    Int    @default(0)

  @@unique([eventId, artistId])
  @@index([eventId])
  @@index([artistId])
}

/**
 * One performance of a multi-date event ("suất diễn") — e.g. a show running
 * every evening for a month. Each showtime has its own ticket types (and so
 * its own inventory); Event.startTime/endTime become the span of all of them.
 * An event with no showtimes is a single performance at Event.startTime.
 * General-admission events only — a SEATMAP event has one seat map.
 */
model Showtime {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())

  ticketTypes TicketType[]

  @@index([eventId, startTime])
}

model TicketType {
  id             String               @id @default(uuid())
  eventId        String
  event          Event                @relation(fields: [eventId], references: [id])
  // Set when the event has showtimes: this tier (and its inventory) belongs to that performance.
  showtimeId     String?
  showtime       Showtime?            @relation(fields: [showtimeId], references: [id], onDelete: Restrict)
  // Set on the tier that sells a SEATMAP event's standing zone (SeatZone.isGeneral)
  // by quantity — created/replaced with the seat map (seat-map.service.ts), so
  // standing tickets use the normal ticket-type hold/release/refund path.
  seatZoneId     String?              @unique
  seatZone       SeatZone?            @relation(fields: [seatZoneId], references: [id], onDelete: SetNull)
  name           String
  price          Decimal              @db.Decimal(12, 2)
  quantityTotal  Int
  quantitySold   Int                  @default(0)
  salesStart     DateTime?
  salesEnd       DateTime?
  deliveryMethod TicketDeliveryMethod @default(E_TICKET)
  description    String? // what this tier includes ("quyền lợi") — shown under the tier on the event page
  // Per-ORDER bounds, enforced at reserve time (holds.service.ts reserveTicketType) — distinct from
  // Event.maxTicketsPerAccount, which caps an account across all its orders for the event.
  minPerOrder    Int                  @default(1)
  maxPerOrder    Int? // null = only the event/account-level caps apply
  isHidden       Boolean              @default(false) // off sale and not listed publicly (e.g. a tier not yet released) — the organizer still sees it

  @@index([eventId])
  @@index([showtimeId])
}

model SeatMap {
  id         String     @id @default(uuid())
  eventId    String     @unique
  event      Event      @relation(fields: [eventId], references: [id])
  // Hall canvas drawn in the web's seat-map designer: a gridRows x gridCols
  // grid with the stage above row 0; every seat sits on one cell
  // (Seat.gridRow/gridCol), empty cells are aisles. All null on maps built
  // the old way (one rows x seatsPerRow block per zone).
  gridRows   Int?
  gridCols   Int?
  stageLabel String?
  zones      SeatZone[]
}

model SeatZone {
  id         String      @id @default(uuid())
  seatMapId  String
  seatMap    SeatMap     @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal     @db.Decimal(12, 2)
  isGeneral  Boolean     @default(false)
  capacity   Int?
  color      String? // "#rrggbb" — how the zone's seats are painted on the hall map
  seats      Seat[]
  ticketType TicketType? // standing zones only: the tier that sells it by quantity
}

model Seat {
  id      String     @id @default(uuid())
  zoneId  String
  zone    SeatZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  row     String
  number  String
  // Cell on the hall canvas (SeatMap.gridRows x gridCols); null on old maps.
  gridRow Int?
  gridCol Int?
  status  SeatStatus @default(AVAILABLE)

  @@unique([zoneId, row, number])
  @@index([zoneId])
  @@index([status])
}

model DiscountCode {
  id            String       @id @default(uuid())
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  code          String
  discountType  DiscountType
  value         Decimal      @db.Decimal(12, 2)
  quantityTotal Int
  quantityUsed  Int          @default(0)
  validFrom     DateTime?
  validTo       DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@unique([eventId, code])
}

/**
 * Append-only activity/audit log — docs/spec/14-activity-log-design.md.
 * Every service keeps its own (database-per-service); the frontend merges
 * the five feeds. A DB trigger (see this table's migration) rejects UPDATE
 * and DELETE, so a row, once written, is evidence.
 */
model ActivityLog {
  id            String   @id @default(uuid())
  actorId       String // userId, "system" for consumers/crons, "anonymous" for e.g. a failed login
  actorRole     String? // CUSTOMER | ORGANIZER | ADMIN | SYSTEM
  action        String // "<entity>.<verb>", e.g. "order.created"
  targetType    String
  targetId      String?
  eventId       String? // ID-only reference into event-service — scope of the organizer's per-event log
  subjectUserId String? // ID-only reference into user-service — whose account this concerns (customer's "my activity")
  summary       String
  metadata      Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([eventId, createdAt])
  @@index([createdAt])
}

// What only the event's organizer and admins see — never part of Event, so no
// public read (search, detail, favorites, recommendations) can leak it.
// onlineUrl reaches ticket holders through ticket-service's ticket page
// (GET /internal/events/:id/online-access). Payout/invoice: where the sales
// money goes and the VAT-invoice ("hoá đơn đỏ") details.
model EventPrivateInfo {
  eventId             String   @id
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  onlineUrl           String?
  payoutAccountHolder String?
  payoutAccountNumber String?
  payoutBankName      String?
  payoutBankBranch    String?
  invoiceBusinessType String? // "INDIVIDUAL" | "COMPANY"
  invoiceName         String?
  invoiceAddress      String?
  invoiceTaxCode      String?
  updatedAt           DateTime @updatedAt
}

/**
 * "Theo dõi" on the artist page — ID-only userId, same convention as EventFavorite.
 */
model ArtistFollow {
  id        String   @id @default(uuid())
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  userId    String // ID-only reference into user-service
  createdAt DateTime @default(now())

  @@unique([artistId, userId])
  @@index([userId])
}

/**
 * The artist page's "Bài đăng" feed. There are no artist accounts: posts are
 * written by an admin or by an organizer who has the artist in one of their
 * lineups (ArtistsService.canPost). membersOnly posts show their content only
 * to holders of an active membership card of that artist.
 */
model ArtistPost {
  id          String   @id @default(uuid())
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  authorId    String // ID-only reference into user-service
  content     String
  imageUrl    String?
  membersOnly Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([artistId, createdAt])
}
