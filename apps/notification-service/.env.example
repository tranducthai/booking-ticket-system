PORT=3006
DATABASE_URL=postgresql://user:password@localhost:5438/notification_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
USER_SERVICE_URL=http://localhost:3001
EVENT_SERVICE_URL=http://localhost:3002
TICKET_SERVICE_URL=http://localhost:3005
# Verifies the JWT off a Socket.io handshake (src/inbox/inbox.gateway.ts) —
# the one place in this service that checks a token itself instead of
# trusting X-User-Id from the gateway (sockets don't go through it, see
# apps/api-gateway/src/proxy/routes.ts). Must match every other service's
# JWT_ACCESS_SECRET (user-service signs the token).
JWT_ACCESS_SECRET=change-me-access
# Email provider — "smtp" (default) talks to the Mailpit container below;
# "ses" sends through AWS SES (production) using nodemailer's built-in SES
# transport, see src/mailer/mailer.service.ts. Credentials for "ses" come
# from the standard AWS SDK chain (IAM role in production) — nothing to set
# here beyond AWS_REGION.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@ticketbox.local
# Only read when EMAIL_PROVIDER=ses.
AWS_REGION=us-east-1
# Shared secret checked on /internal/* routes (docs/spec/12-resilience-and-failure-design.md).
# Leave unset in local dev to skip the check; every service must agree on the same value when set.
INTERNAL_TOKEN=

# EventReminderService (src/notifications/event-reminder.service.ts) — polls
# event-service for events starting in [hoursBefore ± bandHours/2] and emails
# every attendee once. Defaults: remind 24h before, checked every 15 minutes.
EVENT_REMINDER_HOURS_BEFORE=24
EVENT_REMINDER_BAND_HOURS=1
EVENT_REMINDER_TICK_MS=900000
