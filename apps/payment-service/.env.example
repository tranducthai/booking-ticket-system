PORT=3004
DATABASE_URL=postgresql://user:password@localhost:5436/payment_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
BOOKING_SERVICE_URL=http://localhost:3003
SELF_BASE_URL=http://localhost:3004
FRONTEND_URL=http://localhost:5173
# Shared secret checked on /internal/* routes (docs/spec/12-resilience-and-failure-design.md).
# Leave unset in local dev to skip the check; every service must agree on the same value when set.
INTERNAL_TOKEN=

# "mock" (default) runs the whole Saga locally with no real gateway account —
# every method below (vnpay/momo/paypal) routes through
# src/gateway/mock.gateway.ts regardless of which one the customer picked.
# Switch to "live" to dispatch by Payment.method to the matching real
# gateway class instead — each one then needs its OWN real credentials
# filled in below or it fails at the provider (see each gateway's own doc
# comment for how to get sandbox credentials).
PAYMENT_GATEWAY_MODE=mock

# VNPay sandbox — https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=sandbox-tmn-code
VNPAY_HASH_SECRET=sandbox-hash-secret
VNPAY_RETURN_URL=http://localhost:3000/payment/payments/return/vnpay
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_REFUND_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# MoMo sandbox (AIO v2) — sign up for a test merchant at https://developers.momo.vn
MOMO_PARTNER_CODE=sandbox-partner-code
MOMO_ACCESS_KEY=sandbox-access-key
MOMO_SECRET_KEY=sandbox-secret-key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
MOMO_REDIRECT_URL=http://localhost:3000/payment/payments/return/momo
MOMO_IPN_URL=http://localhost:3004/payments/webhook/momo

# PayPal REST (sandbox) — create a sandbox app at https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID=sandbox-client-id
PAYPAL_CLIENT_SECRET=sandbox-client-secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PayPal can't charge VND directly — amounts are converted at this fixed rate (no live FX feed wired up).
PAYPAL_CURRENCY=USD
PAYPAL_VND_TO_USD_RATE=25400
PAYPAL_RETURN_URL=http://localhost:3000/payment/payments/return/paypal
PAYPAL_CANCEL_URL=http://localhost:5173/thanh-toan
