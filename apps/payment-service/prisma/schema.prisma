// Payment Service — owns PAYMENTS, REFUNDS. See docs/spec/07-database-schema.md §4.

generator client {
  provider = "prisma-client-js"
  // See apps/user-service/prisma/schema.prisma for why this is here.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// docs/spec/13-refund-and-anti-fraud-design.md §2.2 state machine:
//   REQUESTED <-> NEED_INFO
//   REQUESTED|NEED_INFO -> APPROVED -> PROCESSING -> COMPLETED | FAILED (retried)
//   REQUESTED|NEED_INFO -> REJECTED -> ESCALATED -> APPROVED | REJECTED_FINAL
//   REQUESTED|NEED_INFO|ESCALATED -> WITHDRAWN
enum RefundStatus {
  REQUESTED
  NEED_INFO
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
  ESCALATED
  REJECTED_FINAL
  WITHDRAWN
}

enum RefundKind {
  CUSTOMER_REQUEST
  EVENT_CANCELED
  EVENT_POSTPONED
  SYSTEM_ERROR
}

model Payment {
  id                 String        @id @default(uuid())
  orderId            String // ID-only reference into booking-service
  amount             Decimal       @db.Decimal(12, 2)
  method             String // GATEWAY_METHODS: "vnpay" | "momo" | "paypal" | "sepay"
  status             PaymentStatus @default(PENDING)
  gatewayTxnId       String?
  gatewayRawResponse Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  refunds Refund[]

  @@index([orderId])
}

model Refund {
  id          String       @id @default(uuid())
  paymentId   String
  payment     Payment      @relation(fields: [paymentId], references: [id])
  orderId     String // ID-only reference into booking-service, denormalized for lookup
  eventId     String? // ID-only reference into event-service — who may review it; null only on rows created before 13-refund-and-anti-fraud-design
  userId      String? // the order's owner (who gets the money/notification) — differs from requestedBy for system-initiated refunds
  kind        RefundKind   @default(CUSTOMER_REQUEST)
  reasonCategory String? // RefundReasonCategory from libs/event-contracts
  reason      String
  orderItemIds String[]    @default([]) // tickets locked in REFUND_PENDING by this request (ticket-service)
  grossAmount Decimal?     @db.Decimal(12, 2) // what was paid
  refundPercent Int        @default(100) // policy tier applied (a reviewer may raise it, never lower it)
  amount      Decimal      @db.Decimal(12, 2) // what goes back = grossAmount * refundPercent / 100
  feeAmount   Decimal      @default(0) @db.Decimal(12, 2) // what's retained = grossAmount - amount
  status      RefundStatus @default(REQUESTED)
  requestedBy String // userId, or "system"
  decidedBy   String? // organizer/admin userId
  rejectReason String?
  infoRequest String? // reviewer's latest "please provide..." message
  slaDueAt    DateTime? // organizer must decide by then, else the customer may escalate to admin
  escalatedAt DateTime?
  gatewayRefundId String?
  attempts    Int          @default(0) // gateway calls made
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  decidedAt   DateTime?
  completedAt DateTime?

  evidence  RefundEvidence[]
  auditLogs RefundAuditLog[]

  @@index([orderId])
  @@index([status])
  @@index([eventId, status])
}

/** Customer-uploaded proof (medical certificate, screenshot...) — bytes live in EvidenceStorage, not the DB. */
model RefundEvidence {
  id         String   @id @default(uuid())
  refundId   String
  refund     Refund   @relation(fields: [refundId], references: [id])
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  sha256     String
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([refundId])
}

/** Who moved a refund between states and why — the paper trail for disputes. */
model RefundAuditLog {
  id         String   @id @default(uuid())
  refundId   String
  refund     Refund   @relation(fields: [refundId], references: [id])
  actorId    String // userId or "system"
  action     String // "REQUEST" | "APPROVE" | "REJECT" | "NEED_INFO" | "RESPOND" | "ESCALATE" | "WITHDRAW" | "COMPLETE" | "FAIL" | ...
  fromStatus String?
  toStatus   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([refundId])
}

/** Same rationale as booking-service's ProcessedEvent — payment-service's first broker consumer (EventCanceled). */
model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  consumer    String
  processedAt DateTime @default(now())
}

/**
 * Append-only activity/audit log — docs/spec/14-activity-log-design.md.
 * Every service keeps its own (database-per-service); the frontend merges
 * the five feeds. A DB trigger (see this table's migration) rejects UPDATE
 * and DELETE, so a row, once written, is evidence.
 */
model ActivityLog {
  id            String   @id @default(uuid())
  actorId       String // userId, "system" for consumers/crons, "anonymous" for e.g. a failed login
  actorRole     String? // CUSTOMER | ORGANIZER | ADMIN | SYSTEM
  action        String // "<entity>.<verb>", e.g. "order.created"
  targetType    String
  targetId      String?
  eventId       String? // ID-only reference into event-service — scope of the organizer's per-event log
  subjectUserId String? // ID-only reference into user-service — whose account this concerns (customer's "my activity")
  summary       String
  metadata      Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([eventId, createdAt])
  @@index([createdAt])
}
