PORT=3005
DATABASE_URL=postgresql://user:password@localhost:5437/ticket_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EVENT_SERVICE_URL=http://localhost:3002
USER_SERVICE_URL=http://localhost:3001
TICKET_SIGNING_SECRET=change-me-hmac-secret
# Shared secret checked on /internal/* routes — must match every other service when set.
INTERNAL_TOKEN=

# docs/spec/13-refund-and-anti-fraud-design.md §3. Static QRs are signed with
# an Ed25519 private key (PKCS#8 PEM, "\n"-escaped on one line is fine).
# Generate one with: node scripts/generate-ticket-signing-key.mjs
# Unset = derived from TICKET_SIGNING_SECRET (dev only — logs a warning).
TICKET_SIGNING_PRIVATE_KEY=
TICKET_SIGNING_KID=
