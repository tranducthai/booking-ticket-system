// Ticket Service — owns TICKETS. See docs/spec/07-database-schema.md §5.

generator client {
  provider = "prisma-client-js"
  // See apps/user-service/prisma/schema.prisma for why this is here.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  ISSUED
  // docs/spec/13-refund-and-anti-fraud-design.md §2.2 — locked while a
  // refund request is open: check-in refuses it, so nobody can both enter
  // the venue and get their money back.
  REFUND_PENDING
  USED
  CANCELED
}

model Ticket {
  id          String       @id @default(uuid())
  orderItemId String       @unique // ID-only reference into booking-service, 1-to-1
  eventId     String // ID-only reference into event-service, denormalized for check-in lookups
  userId      String // ID-only reference into user-service, denormalized for "my tickets"
  qrPayload   String       @unique // signed payload encoded into the QR (see 09-event-contracts.md)
  qrSignature String
  // docs/spec/13-refund-and-anti-fraud-design.md §3 — bumped on every QR
  // reissue; any QR (static or dynamic) carrying an older version is dead.
  qrVersion   Int          @default(1)
  status      TicketStatus @default(ISSUED)
  // Refund that currently holds this ticket in REFUND_PENDING (ID-only reference into payment-service).
  refundId    String?
  // Why it became CANCELED — "EVENT_CANCELED" lets notification-service
  // still find the holders of a canceled event after their tickets died.
  cancelReason String?
  checkedInAt DateTime?
  checkedInBy String? // staff userId
  createdAt   DateTime     @default(now())

  @@index([eventId])
  @@index([userId])
  @@index([refundId])
}

/** Same rationale as booking-service's ProcessedEvent — pulled forward from Phase 8c. */
model ProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  consumer    String
  processedAt DateTime @default(now())
}

/**
 * Append-only activity/audit log — docs/spec/14-activity-log-design.md.
 * Every service keeps its own (database-per-service); the frontend merges
 * the five feeds. A DB trigger (see this table's migration) rejects UPDATE
 * and DELETE, so a row, once written, is evidence.
 */
model ActivityLog {
  id            String   @id @default(uuid())
  actorId       String // userId, "system" for consumers/crons, "anonymous" for e.g. a failed login
  actorRole     String? // CUSTOMER | ORGANIZER | ADMIN | SYSTEM
  action        String // "<entity>.<verb>", e.g. "order.created"
  targetType    String
  targetId      String?
  eventId       String? // ID-only reference into event-service — scope of the organizer's per-event log
  subjectUserId String? // ID-only reference into user-service — whose account this concerns (customer's "my activity")
  summary       String
  metadata      Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([eventId, createdAt])
  @@index([createdAt])
}
