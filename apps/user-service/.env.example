PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5433/user_db
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Shared secret checked on /internal/* routes (docs/spec/12-resilience-and-failure-design.md).
# Leave unset in local dev to skip the check; every service must agree on the same value when set.
INTERNAL_TOKEN=

FRONTEND_URL=http://localhost:5173

# Google OAuth (src/auth/oauth/google-oauth.service.ts) — create a Web
# Application OAuth client at https://console.cloud.google.com/apis/credentials,
# authorized redirect URI = GOOGLE_REDIRECT_URI below (through the api-gateway).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/user/auth/google/callback

# Facebook Login (src/auth/oauth/facebook-oauth.service.ts) — create an app
# with the "Facebook Login" product at https://developers.facebook.com/apps,
# same redirect URI convention as Google above.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/user/auth/facebook/callback
