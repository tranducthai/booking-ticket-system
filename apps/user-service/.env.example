PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5433/user_db
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Shared secret checked on /internal/* routes (docs/spec/12-resilience-and-failure-design.md).
# Leave unset in local dev to skip the check; every service must agree on the same value when set.
INTERNAL_TOKEN=
