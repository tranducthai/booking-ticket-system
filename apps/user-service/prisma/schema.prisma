// User Service — owns USERS. See docs/spec/07-database-schema.md §1.

generator client {
  provider = "prisma-client-js"
  // Custom output — pnpm dedupes identical @prisma/client versions across
  // workspace packages to ONE physical store entry, so the default output
  // (node_modules/@prisma/client) gets clobbered by whichever service last
  // ran `prisma generate`. Each service gets its own copy instead.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  CUSTOMER
  ORGANIZER
  ADMIN
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  phone               String?   @unique
  passwordHash        String? // nullable: OAuth-only accounts have no password
  fullName            String
  // "Featured Stars" (docs/spec doesn't call this out — added for the
  // homepage carousel) reads this for verified organizers; any user can set
  // their own via PATCH /users/me, same as an event's bannerUrl — no upload
  // pipeline in this project, just a URL.
  avatarUrl           String?
  // "Thông tin tài khoản" — optional, self-reported.
  dateOfBirth         DateTime? @db.Date
  gender              Gender?
  role                Role      @default(CUSTOMER)
  oauthProvider       String? // "google" | "facebook" | null
  oauthId             String?
  isOrganizerVerified Boolean   @default(false)
  isLocked            Boolean   @default(false)
  emailVerifiedAt     DateTime?
  // When the password last changed (reset, or dropped on OAuth link). Signing
  // out is done by revoking Sessions, not by comparing against this.
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  oauthLoginCodes     OAuthLoginCode[]

  @@index([email])
  @@index([role])
}

/**
 * Single-use "quên mật khẩu" token. Only the SHA-256 of the token is stored —
 * a DB leak doesn't hand out working reset links. Valid until expiresAt and
 * while usedAt is null; a successful reset burns every outstanding token of
 * that user.
 */
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/**
 * Append-only activity/audit log — docs/spec/14-activity-log-design.md.
 * Every service keeps its own (database-per-service); the frontend merges
 * the five feeds. A DB trigger (see this table's migration) rejects UPDATE
 * and DELETE, so a row, once written, is evidence.
 */
model ActivityLog {
  id            String   @id @default(uuid())
  actorId       String // userId, "system" for consumers/crons, "anonymous" for e.g. a failed login
  actorRole     String? // CUSTOMER | ORGANIZER | ADMIN | SYSTEM
  action        String // "<entity>.<verb>", e.g. "order.created"
  targetType    String
  targetId      String?
  eventId       String? // ID-only reference into event-service — scope of the organizer's per-event log
  subjectUserId String? // ID-only reference into user-service — whose account this concerns (customer's "my activity")
  summary       String
  metadata      Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([eventId, createdAt])
  @@index([createdAt])
}

// One row per signed-in device. Every access/refresh token carries its `sid`;
// api-gateway only lets a token through while Redis marks that sid active
// (src/sessions/session.service.ts is the only writer). Only one session per
// user is active at a time — a new login revokes the others ("replaced").
model Session {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  method               String // "password" | "register" | "google" | "facebook"
  // SHA-256 of the one refresh token currently valid for this session —
  // rotated on every /auth/refresh. Presenting an older one is token reuse.
  refreshTokenHash     String
  // The token rotated out last, honored for a few seconds so a refresh
  // whose response got lost (or two tabs racing) isn't mistaken for reuse.
  prevRefreshTokenHash String?
  rotatedAt            DateTime?
  ipAddress            String?
  userAgent            String?
  expiresAt            DateTime
  revokedAt            DateTime?
  revokedReason        String? // "logout" | "replaced" | "password_reset" | "locked" | "refresh_reuse"
  createdAt            DateTime  @default(now())

  @@index([userId, revokedAt])
}

// Single-use, 60-second handoff from the OAuth callback redirect to apps/web
// (POST /auth/oauth/exchange) — the redirect URL never carries real tokens.
model OAuthLoginCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  method    String // "google" | "facebook"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
