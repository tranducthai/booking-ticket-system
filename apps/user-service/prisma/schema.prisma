// User Service — owns USERS. See docs/spec/07-database-schema.md §1.

generator client {
  provider = "prisma-client-js"
  // Custom output — pnpm dedupes identical @prisma/client versions across
  // workspace packages to ONE physical store entry, so the default output
  // (node_modules/@prisma/client) gets clobbered by whichever service last
  // ran `prisma generate`. Each service gets its own copy instead.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ORGANIZER
  ADMIN
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  phone               String?  @unique
  passwordHash        String? // nullable: OAuth-only accounts have no password
  fullName            String
  // "Featured Stars" (docs/spec doesn't call this out — added for the
  // homepage carousel) reads this for verified organizers; any user can set
  // their own via PATCH /users/me, same as an event's bannerUrl — no upload
  // pipeline in this project, just a URL.
  avatarUrl           String?
  role                Role     @default(CUSTOMER)
  oauthProvider       String? // "google" | "facebook" | null
  oauthId             String?
  isOrganizerVerified Boolean  @default(false)
  isLocked            Boolean  @default(false)
  emailVerifiedAt     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([email])
  @@index([role])
}

/**
 * Append-only activity/audit log — docs/spec/14-activity-log-design.md.
 * Every service keeps its own (database-per-service); the frontend merges
 * the five feeds. A DB trigger (see this table's migration) rejects UPDATE
 * and DELETE, so a row, once written, is evidence.
 */
model ActivityLog {
  id            String   @id @default(uuid())
  actorId       String // userId, "system" for consumers/crons, "anonymous" for e.g. a failed login
  actorRole     String? // CUSTOMER | ORGANIZER | ADMIN | SYSTEM
  action        String // "<entity>.<verb>", e.g. "order.created"
  targetType    String
  targetId      String?
  eventId       String? // ID-only reference into event-service — scope of the organizer's per-event log
  subjectUserId String? // ID-only reference into user-service — whose account this concerns (customer's "my activity")
  summary       String
  metadata      Json?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([eventId, createdAt])
  @@index([createdAt])
}
