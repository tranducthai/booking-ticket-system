# Left unset in dev — Vite's proxy (vite.config.ts) forwards /api to the
# gateway instead. Set this for a production build served on its own origin.
VITE_API_BASE_URL=

# notification-service's Socket.io gateway (src/inbox/inbox.gateway.ts) —
# NOT proxied through the api-gateway (it only handles plain HTTP, see
# apps/api-gateway/src/proxy/routes.ts), so the browser connects here
# directly. Defaults to notification-service's own dev port.
VITE_NOTIFICATION_WS_URL=http://localhost:3006
