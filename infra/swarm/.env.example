# Copy this file to `.env` in this same directory (infra/swarm/) and fill in
# real values before running deploy.sh / `docker stack deploy`. `docker stack
# deploy` only auto-loads `.env` from the directory it's run in, so keep
# running it from infra/swarm/.

# Public IP or domain of the VM this stack is deployed on (no scheme/port) —
# used to build payment-service's public callback URL, the frontend's public
# origin, and the browser-facing notification WebSocket URL baked into the
# web build. Example: 132.145.10.20 or ticketbox.example.com
PUBLIC_HOST=

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TICKET_SIGNING_SECRET=
