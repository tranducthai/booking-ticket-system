{
  "name": "booking-ticket-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./apps/* --filter=./libs/* build",
    "lint": "pnpm -r --filter=./apps/* --filter=./libs/* lint",
    "test": "pnpm -r --filter=./apps/* test",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
